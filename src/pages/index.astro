---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Redirecting..." description="Redirecting to myanmardev.com">
  <div style="height: 100vh; display: flex; justify-content: center; align-items: center; font-family: var(--mono); font-size: 0.875rem;">
    Redirecting...
  </div>
  <script is:inline>
    (function() {
      var stored = localStorage.getItem('lang');
      var lang = 'en';
      if (stored === 'en' || stored === 'my') {
        lang = stored;
      } else {
        // Simple heuristic: if browser language is myanmar, use my
        if (navigator.language.startsWith('my')) {
          lang = 'my';
        }
      }
      window.location.replace('/' + lang + '/');
    })();
  </script>
</Layout>
