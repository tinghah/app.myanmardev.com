---
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'my' } }
  ];
}
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

import DashboardContent from '../../components/DashboardContent';
import { t, type Language } from '../../i18n/utils';

const { lang } = Astro.params as { lang: Language };
const title = lang === 'my' ? 'Dashboard — myanmardev.com' : 'Dashboard — myanmardev.com';
const description = 'Manage your tokens, view order history, and track your deployments.';
---

<Layout title={title} description={description} lang={lang}>
  <Header lang={lang} />
  <main class="dashboard-page" style="padding:clamp(2rem,5vw,4rem) 0">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 3rem);">
      <div class="sx rise"><b></b> <span>/ dashboard</span></div>
      <h1 class="h-section rise" style="margin-top: 0.75rem;">Account Overview</h1>
      
      <DashboardContent client:load />
    </div>
  </main>

  <footer style="border-top:1px solid var(--border);background:var(--surface);margin-top:4rem">
    <div style="max-width:78rem;margin:0 auto;padding:clamp(2rem,4vw,3rem) clamp(1.25rem,4vw,3rem);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem">
      <div>
        <a href="/" style="font-family:var(--display);font-weight:700;font-size:1rem;letter-spacing:-.02em">
          <span style="color:var(--accent)">myanmardev</span>.com
        </a>
      </div>
      <div style="display:flex;align-items:center;gap:.5rem">
        <span style="font-family:var(--mono);color:var(--muted);font-size:.625rem;letter-spacing:0.02em">&copy; {new Date().getFullYear()} {t(lang, 'footer.built')}</span>
        <span class="dot" style="width:5px;height:5px"></span>
      </div>
    </div>
  </footer>
</Layout>
