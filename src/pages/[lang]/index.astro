---
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'my' } }
  ];
}
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import Products from '../../components/Products.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Pricing from '../../components/Pricing.astro';
import Testimonials from '../../components/Testimonials.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';
import { t, type Language } from '../../i18n/utils';

const { lang } = Astro.params as { lang: Language };
const title = lang === 'my'
  ? 'myanmardev.com — သင့် Subdomain။ ၃၀ စက္ကန့်အတွင်း Live။'
  : 'myanmardev.com — Your Subdomain. Live in 30 Seconds.';
const description = lang === 'my'
  ? 'Coding မလို။ စောင့်ရန်မလို။ ချက်ချင်း deploy။ မြန်မာ developer များအတွက်။'
  : 'Automated web services for Myanmar developers. Subdomains, websites, portfolios — deploy in seconds.';
---

<Layout title={title} description={description} lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Stats lang={lang} />
    <Products lang={lang} />
    <HowItWorks lang={lang} />
    <Pricing lang={lang} />
    <Testimonials lang={lang} />
    <CTA lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
