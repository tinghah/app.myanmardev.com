---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  lang: string;
}

const { title, lang } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={`${title} | Admin`} lang={lang}>
  <!-- Admin Guard Script -->
  <script>
    import { $authState, redirectAdminIfNeeded } from '../stores/authStore';

    const SUPER_ADMIN_EMAILS = [
      'myanmardevadmin@gmail.com',
      'ting.pouchen@gmail.com'
    ];

    function isSuperAdminEmail(email: string | null | undefined): boolean {
      if (!email) return false;
      return SUPER_ADMIN_EMAILS.includes(email.toLowerCase());
    }

    // Subscribe to auth state changes to protect the route
    $authState.subscribe((state) => {
      if (!state.loading) {
        // Check admin status from both profile AND Firebase Auth email (belt-and-suspenders)
        const isAdmin = state.profile?.isAdmin || isSuperAdminEmail(state.user?.email);

        if (!state.isSignedIn || !isAdmin) {
          // If they aren't logged in, or aren't an admin, redirect them
          // to the standard user dashboard or home.
          window.location.href = `/${document.documentElement.lang}/dashboard`;
        }
      }
    });
  </script>

  <Header lang={lang as any} />
  
  <main style="padding: 2rem; min-height: calc(100vh - 70px); background: var(--base);">
    <div style="max-width: 1200px; margin: 0 auto; padding-top: 2rem;">
      <h1 style="font-family: var(--display); font-size: 2rem; margin-bottom: 2rem; color: var(--ink);">
        {title}
      </h1>
      <slot />
    </div>
  </main>
</Layout>
