---
import AuthButton from './AuthButton';
import TokenBalance from './TokenBalance';
import NotificationBell from './NotificationBell';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href={`/${lang}/`} class="logo" aria-label="APP.MYANMARDEV.COM home">
      <img src="/images/logo/mmdev.svg" alt="APP.MYANMARDEV.COM" style="height: 40px; width: auto;" />
    </a>

    <!-- Desktop Nav -->
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href={`/${lang}/#products`} class="nav-link user-link">{t(lang, 'nav.products')}</a>
      <a href={`/${lang}/#pricing`} class="nav-link user-link">{t(lang, 'nav.pricing')}</a>
      <a href={`/${lang}/dashboard`} class="nav-link user-link">{t(lang, 'nav.myBusiness')}</a>
      <a href={`/${lang}/admin/analytics`} class="nav-link admin-link" style="display: none;">Analytics</a>
      <a href={`/${lang}/admin/users`} class="nav-link admin-link" style="display: none;">Users</a>
      <a href={`/${lang}/admin/codes`} class="nav-link admin-link" style="display: none;">Redeem Codes</a>
      <a href={`/${lang}/admin/orders`} class="nav-link admin-link" style="display: none;">Orders</a>
      <a href={`/${lang}/admin/products`} class="nav-link admin-link" style="display: none;">Products</a>
      <a href={`/${lang}/admin/chat`} class="nav-link admin-link" style="display: none;">Chat</a>
    </nav>

    <!-- Controls -->
    <div class="controls">
      <TokenBalance client:load />
      <NotificationBell client:load />
      <LanguageSwitcher currentLang={lang} />
      <ThemeToggle />
      <AuthButton client:load />
      <button class="hamburger" id="hamburger-btn" aria-label={t(lang, 'nav.menu')} aria-expanded="false" aria-controls="mobile-nav">
        <span class="ham-line"></span>
        <span class="ham-line"></span>
        <span class="ham-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <a href={`/${lang}/#products`} class="mobile-link user-link">{t(lang, 'nav.products')}</a>
    <a href={`/${lang}/#pricing`} class="mobile-link user-link">{t(lang, 'nav.pricing')}</a>
    <a href={`/${lang}/dashboard`} class="mobile-link user-link">{t(lang, 'nav.myBusiness')}</a>
    <a href={`/${lang}/admin/analytics`} class="mobile-link admin-link" style="display: none;">Analytics</a>
    <a href={`/${lang}/admin/users`} class="mobile-link admin-link" style="display: none;">Users</a>
    <a href={`/${lang}/admin/codes`} class="mobile-link admin-link" style="display: none;">Redeem Codes</a>
    <a href={`/${lang}/admin/orders`} class="mobile-link admin-link" style="display: none;">Orders</a>
    <a href={`/${lang}/admin/products`} class="mobile-link admin-link" style="display: none;">Products</a>
    <a href={`/${lang}/admin/chat`} class="mobile-link admin-link" style="display: none;">Chat</a>
    <div class="mobile-controls">
      <LanguageSwitcher currentLang={lang} />
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--base) 80%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .site-header.scrolled {
    background: color-mix(in srgb, var(--base) 95%, transparent);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    min-height: 3.5rem;
  }

  /* ─── Logo ─── */
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0.5rem 0;
    transition: opacity 0.15s ease;
  }
  .logo:hover { opacity: 0.85; color: inherit; }

  /* ─── Desktop Nav ─── */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    position: relative;
    padding: 0.45rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  body[data-admin="true"] .user-link {
    display: none !important;
  }
  body[data-admin="true"] .admin-link {
    display: block !important;
  }
  @media (min-width: 769px) {
    body[data-admin="true"] .admin-link.nav-link {
      display: inline-block !important;
    }
  }

  /* ─── Controls ─── */
  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ─── Hamburger ─── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .hamburger:hover {
    background: var(--surface-2);
    border-color: var(--border-accent);
  }

  .ham-line {
    display: block;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease, width 0.25s ease;
  }

  .hamburger[aria-expanded="true"] .ham-line:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .ham-line:nth-child(2) {
    opacity: 0; width: 0;
  }
  .hamburger[aria-expanded="true"] .ham-line:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ─── Mobile Nav ─── */
  .mobile-nav {
    display: none;
    flex-direction: column;
    border-top: 1px solid var(--border);
    padding: 0.75rem 0;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
  }
  .mobile-nav.open {
    max-height: 400px;
  }

  .mobile-link {
    display: block;
    padding: 0.75rem clamp(1.25rem, 4vw, 3rem);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .mobile-link:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .mobile-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--border);
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .desktop-nav { display: none; }
    .hamburger   { display: flex; }
    .mobile-nav  { display: flex; }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('hamburger-btn');
    var nav = document.getElementById('mobile-nav');
    var header = document.getElementById('site-header');
    if (!btn || !nav) return;

    btn.addEventListener('click', function () {
      var isOpen = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      nav.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    });

    nav.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') {
        nav.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        nav.setAttribute('aria-hidden', 'true');
      }
    });

    // Scrolled state
    if (header) {
      window.addEventListener('scroll', function () {
        header.classList.toggle('scrolled', window.scrollY > 10);
      }, { passive: true });
    }
  })();
</script>
