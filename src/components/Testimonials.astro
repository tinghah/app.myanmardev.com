---
import { t, type Language } from '../i18n/utils';
const { lang = 'en' } = Astro.props as { lang: Language };

const avatarColors = [
  { bg: 'rgba(245,158,11,0.15)', color: 'var(--accent)' },
  { bg: 'rgba(99,102,241,0.15)', color: '#818cf8' },
  { bg: 'rgba(34,197,94,0.15)', color: '#22c55e' },
];
---

<section id="testimonials" class="section-pad" style="border-bottom: 1px solid var(--border);">
  <div class="container">
    <div class="sx rise"><b></b> <span>{t(lang, 'testimonials.section')}</span></div>
    <h2 class="h-section rise" style="margin-top: 0.75rem;">{t(lang, 'testimonials.heading')}</h2>
    <p class="lede rise" style="margin-top: 0.5rem;">{t(lang, 'testimonials.sub')}</p>

    <div class="testimonials-grid">
      {[1, 2, 3].map((i, idx) => (
        <div class="testimonial-card card-glass rise">
          <!-- Large quote mark -->
          <div class="quote-mark" aria-hidden="true">"</div>

          <!-- Stars -->
          <div class="stars" aria-label="5 stars">
            {"★★★★★".split('').map(s => <span class="star">{s}</span>)}
          </div>

          <!-- Quote text -->
          <blockquote class="quote-text">
            {t(lang, `testimonials.t${i}.q`)}
          </blockquote>

          <!-- Author -->
          <div class="testimonial-author">
            <div
              class="testimonial-avatar"
              style={`background: ${avatarColors[idx].bg}; color: ${avatarColors[idx].color};`}
            >
              {t(lang, `testimonials.t${i}.a`).charAt(0)}
            </div>
            <div class="author-info">
              <div class="author-name">{t(lang, `testimonials.t${i}.a`)}</div>
              <div class="author-role">{t(lang, `testimonials.t${i}.role`)}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom social proof bar -->
    <div class="social-proof rise">
      <div class="social-proof-stars">★★★★★</div>
      <div class="social-proof-text">
        Trusted by <strong>50+ Myanmar developers</strong> · Yangon, Mandalay, Naypyidaw &amp; beyond
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  /* ─── Testimonial Card ─── */
  .testimonial-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }

  .quote-mark {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-family: Georgia, serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.15;
    pointer-events: none;
    user-select: none;
  }

  /* ─── Stars ─── */
  .stars {
    display: flex;
    gap: 2px;
  }

  .star {
    color: var(--accent);
    font-size: 0.75rem;
    line-height: 1;
  }

  /* ─── Quote ─── */
  .quote-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-2);
    flex: 1;
    font-style: normal;
    quotes: none;
  }

  /* ─── Author ─── */
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .testimonial-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .author-name {
    font-family: var(--display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  .author-role {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 2px;
  }

  /* ─── Social Proof Bar ─── */
  .social-proof {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
    padding: 1rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  .social-proof-stars {
    color: var(--accent);
    font-size: 1rem;
    letter-spacing: 2px;
    flex-shrink: 0;
  }

  .social-proof-text {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .social-proof-text strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .testimonials-grid { grid-template-columns: 1fr; }
  }

  @media (min-width: 640px) and (max-width: 900px) {
    .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
