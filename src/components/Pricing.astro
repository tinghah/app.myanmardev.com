---
import { t, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<section id="pricing" class="section-pad" style="border-bottom: 1px solid var(--border);">
  <div class="container">
    <div class="pricing-header-block">
      <div class="sx rise"><b></b> <span>{t(lang, 'pricing.section')}</span></div>
      <h2 class="h-section rise" style="margin-top: 0.75rem;">{t(lang, 'pricing.heading')}</h2>
      <p class="lede rise" style="margin-top: 0.5rem;">{t(lang, 'pricing.sub')}</p>
    </div>

    <div class="pricing-grid">

      <!-- Starter -->
      <div class="pricing-card card-glass rise">
        <div class="pricing-tier-name">{t(lang, 'pricing.starter.name')}</div>
        <div class="pricing-price-block">
          <span class="pricing-amount">{t(lang, 'pricing.starter.usd')}</span>
          <span class="pricing-mmk">{t(lang, 'pricing.starter.mmk')}</span>
        </div>
        <div class="pricing-tokens-row">
          <span class="pricing-tokens-num pricing-tokens-num--accent">{t(lang, 'pricing.starter.tokens')}</span>
          <span class="pricing-tokens-label">Tokens</span>
        </div>
        <ul class="pricing-perks">
          <li><span class="perk-check">✓</span> 5 subdomain registrations</li>
          <li><span class="perk-check">✓</span> Instant DNS activation</li>
          <li><span class="perk-check">✓</span> Free SSL on all domains</li>
          <li><span class="perk-check" style="color: #ef4444;">❌</span> Priority support</li>
          <li><span class="perk-check">✓</span> Tokens expire in 3 days</li>
        </ul>
        <a href={`/${lang}/auth/signin`} class="btn btn--ghost" style="width: 100%; justify-content: center; margin-top: auto; padding-top: 1rem;">
          {t(lang, 'pricing.buy')}
        </a>
      </div>

      <!-- Basic -->
      <div class="pricing-card card-glass rise">
        <div class="pricing-tier-name">{t(lang, 'pricing.basic.name')}</div>
        <div class="pricing-price-block">
          <span class="pricing-amount">{t(lang, 'pricing.basic.usd')}</span>
          <span class="pricing-mmk">{t(lang, 'pricing.basic.mmk')}</span>
        </div>
        <div class="pricing-tokens-row">
          <span class="pricing-tokens-num pricing-tokens-num--accent">{t(lang, 'pricing.basic.tokens')}</span>
          <span class="pricing-tokens-label">Tokens</span>
        </div>
        <ul class="pricing-perks">
          <li><span class="perk-check">✓</span> 10 subdomain registrations</li>
          <li><span class="perk-check">✓</span> 3 website builders</li>
          <li><span class="perk-check" style="color: #ef4444;">❌</span> Priority support</li>
          <li><span class="perk-check">✓</span> Tokens expire in 7 days</li>
        </ul>
        <a href={`/${lang}/auth/signin`} class="btn btn--ghost" style="width: 100%; justify-content: center; margin-top: auto; padding-top: 1rem;">
          {t(lang, 'pricing.buy')}
        </a>
      </div>

      <!-- Pro — Featured -->
      <div class="pricing-card card-glass card-featured pricing-card--featured rise">
        <div class="pricing-featured-badge">
          <span class="badge badge--popular">⭐ {t(lang, 'pricing.popular')}</span>
        </div>
        <div class="pricing-tier-name">{t(lang, 'pricing.pro.name')}</div>
        <div class="pricing-price-block">
          <span class="pricing-amount pricing-amount--accent">{t(lang, 'pricing.pro.usd')}</span>
          <span class="pricing-mmk">{t(lang, 'pricing.pro.mmk')}</span>
        </div>
        <div class="pricing-tokens-row">
          <span class="pricing-tokens-num pricing-tokens-num--accent">{t(lang, 'pricing.pro.tokens')}</span>
          <span class="pricing-tokens-label">Tokens</span>
        </div>
        <ul class="pricing-perks">
          <li><span class="perk-check">✓</span> 25 subdomain registrations</li>
          <li><span class="perk-check">✓</span> 8 website builders</li>
          <li><span class="perk-check">✓</span> Priority DNS provisioning start</li>
          <li><span class="perk-check">✓</span> Priority support</li>
          <li><span class="perk-check">✓</span> Tokens never expire</li>
        </ul>
        <a href={`/${lang}/auth/signin`} class="btn" style="width: 100%; justify-content: center; margin-top: auto; padding-top: 1rem;">
          {t(lang, 'pricing.buy')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

      <!-- Business -->
      <div class="pricing-card card-glass rise">
        <div class="pricing-tier-name">{t(lang, 'pricing.business.name')}</div>
        <div class="pricing-price-block">
          <span class="pricing-amount">{t(lang, 'pricing.business.usd')}</span>
          <span class="pricing-mmk">{t(lang, 'pricing.business.mmk')}</span>
        </div>
        <div class="pricing-tokens-row">
          <span class="pricing-tokens-num pricing-tokens-num--accent">{t(lang, 'pricing.business.tokens')}</span>
          <span class="pricing-tokens-label">Tokens</span>
        </div>
        <ul class="pricing-perks">
          <li><span class="perk-check">✓</span> 50 subdomain registrations</li>
          <li><span class="perk-check">✓</span> Unlimited website builders</li>
          <li><span class="perk-check">✓</span> All future products</li>
          <li><span class="perk-check">✓</span> Dedicated support channel</li>
          <li><span class="perk-check">✓</span> Tokens never expire</li>
        </ul>
        <a href={`/${lang}/auth/signin`} class="btn btn--ghost" style="width: 100%; justify-content: center; margin-top: auto; padding-top: 1rem;">
          {t(lang, 'pricing.buy')}
        </a>
      </div>

    </div>

    <!-- Token value explainer -->
    <div class="token-explainer rise">
      <div class="token-explainer-inner">
        <div class="token-exp-icon">🪙</div>
        <div>
          <div class="token-exp-title">How tokens work</div>
          <div class="token-exp-desc">1 Token = $0.50 USD = 2,000 MMK · Subdomain costs 1 token · Tokens stack and never expire · Buy once, use any time<br/>1 USDT = 4000 MMK [FIXED Rate]</div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .pricing-header-block { margin-bottom: 2.5rem; }

  /* ─── Pricing Grid ─── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  /* ─── Pricing Card ─── */
  .pricing-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    height: 100%;
    min-height: 380px;
    position: relative;
  }

  .pricing-card--featured {
    transform: scale(1.03);
    z-index: 2;
  }

  .pricing-featured-badge {
    margin-bottom: 0.75rem;
  }

  .pricing-tier-name {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .pricing-price-block {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .pricing-amount {
    font-family: var(--mono);
    font-weight: 800;
    font-size: 2rem;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .pricing-amount--accent {
    color: var(--accent);
    text-shadow: 0 0 20px var(--glow);
  }

  .pricing-mmk {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .pricing-tokens-row {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .pricing-tokens-num {
    font-family: var(--mono);
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--ink-2);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .pricing-tokens-num--accent { color: var(--accent); }

  .pricing-tokens-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ─── Perks List ─── */
  .pricing-perks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .pricing-perks li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.4;
  }

  .perk-check {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: #22c55e;
    font-weight: 700;
    flex-shrink: 0;
    width: 14px;
    text-align: center;
  }

  /* ─── Token explainer ─── */
  .token-explainer {
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .token-explainer-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .token-exp-icon { font-size: 1.5rem; flex-shrink: 0; }

  .token-exp-title {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .token-exp-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1200px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
    .pricing-card--featured { transform: none; }
  }

  @media (max-width: 640px) {
    .pricing-grid { grid-template-columns: 1fr; }
  }
</style>
