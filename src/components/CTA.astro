---
import { t, type Language } from '../i18n/utils';
const { lang = 'en' } = Astro.props as { lang: Language };
---

<section id="cta" class="cta-section">
  <!-- Background gradient -->
  <div class="cta-bg" aria-hidden="true"></div>
  <div class="cta-grid-overlay" aria-hidden="true"></div>

  <div class="container cta-inner">
    <div class="cta-badge rise">
      <span class="badge badge--popular">🚀 Join the Platform</span>
    </div>

    <h2 class="h-display rise cta-heading">
      {t(lang, 'cta.heading')}
    </h2>

    <p class="lede rise cta-sub">
      {t(lang, 'cta.sub')}
    </p>

    <div class="rise cta-actions">
      <a href={`/${lang}/auth/signin`} class="btn btn--cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
        {t(lang, 'cta.start')}
      </a>
      <a href={`#pricing`} class="btn btn--cta-ghost">
        {t(lang, 'cta.pricing')}
      </a>
    </div>

    <!-- Social proof row -->
    <div class="rise cta-proof">
      <div class="proof-avatars">
        <div class="proof-avatar" style="background: rgba(245,158,11,0.2); color: var(--accent);">A</div>
        <div class="proof-avatar" style="background: rgba(99,102,241,0.2); color: #818cf8;">Z</div>
        <div class="proof-avatar" style="background: rgba(34,197,94,0.2); color: #22c55e;">H</div>
        <div class="proof-avatar" style="background: rgba(239,68,68,0.2); color: #f87171;">K</div>
        <div class="proof-avatar" style="background: rgba(168,85,247,0.2); color: #c084fc;">M</div>
      </div>
      <div class="proof-text">
        <span class="proof-stars">★★★★★</span>
        <span>Trusted by <strong>50+ Myanmar developers</strong></span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: clamp(5rem, 12vw, 8rem) clamp(1.25rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* ─── Background ─── */
  .cta-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 50% 100%, rgba(245,158,11,0.15) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 20% 50%, rgba(245,158,11,0.06) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 80% 30%, rgba(239,68,68,0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .cta-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, rgba(0,0,0,0.4) 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, rgba(0,0,0,0.4) 0%, transparent 100%);
    pointer-events: none;
    opacity: 0.5;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-badge {
    margin-bottom: 1.5rem;
  }

  .cta-heading {
    max-width: 20ch;
    background: linear-gradient(135deg, var(--ink) 0%, var(--accent-light) 60%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0 auto;
  }

  .cta-sub {
    margin: 1.25rem auto 0;
    text-align: center;
    max-width: 50ch;
    font-size: 1.0625rem;
  }

  /* ─── CTA Actions ─── */
  .cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .btn--cta {
    background: linear-gradient(135deg, var(--accent), var(--accent-dim));
    border-color: transparent;
    color: #000;
    padding: 1rem 2rem;
    font-size: 0.8125rem;
    box-shadow: 0 4px 32px var(--glow-strong), 0 0 0 1px rgba(245,158,11,0.3);
  }
  .btn--cta:hover {
    box-shadow: 0 8px 48px var(--glow-strong);
    transform: translateY(-2px);
  }

  .btn--cta-ghost {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.15);
    color: var(--ink);
    padding: 1rem 2rem;
    font-size: 0.8125rem;
    backdrop-filter: blur(8px);
  }
  .btn--cta-ghost:hover {
    background: rgba(255,255,255,0.10);
    border-color: var(--border-accent);
    color: var(--accent);
    box-shadow: none;
  }

  /* ─── Social Proof ─── */
  .cta-proof {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    justify-content: center;
  }

  .proof-avatars {
    display: flex;
    align-items: center;
  }

  .proof-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 700;
    border: 2px solid var(--base);
    margin-right: -8px;
    flex-shrink: 0;
  }
  .proof-avatar:last-child { margin-right: 0; }

  .proof-text {
    font-size: 0.8125rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .proof-stars {
    color: var(--accent);
    letter-spacing: 1px;
  }

  .proof-text strong {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .cta-actions { flex-direction: column; align-items: stretch; }
    .cta-actions .btn { justify-content: center; }
    .cta-proof { flex-direction: column; gap: 0.75rem; }
  }
</style>
