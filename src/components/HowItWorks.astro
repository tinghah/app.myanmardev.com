---
import { t, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const steps = [
  {
    num: '01',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    titleKey: 'how.s1',
    descKey: 'how.s1d',
  },
  {
    num: '02',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>`,
    titleKey: 'how.s2',
    descKey: 'how.s2d',
  },
  {
    num: '03',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    titleKey: 'how.s3',
    descKey: 'how.s3d',
  },
];
---

<section id="how" class="section-pad" style="border-bottom: 1px solid var(--border); background: var(--surface);">
  <div class="container">
    <div class="sx rise"><b></b> <span>{t(lang, 'how.section')}</span></div>
    <h2 class="h-section rise" style="margin-top: 0.75rem;">{t(lang, 'how.heading')}</h2>

    <div class="how-timeline">
      {steps.map((step, i) => (
        <div class="how-step rise">
          <!-- Step number + connector -->
          <div class="step-track">
            <div class="step-bubble">
              <span class="step-num">{step.num}</span>
            </div>
            {i < steps.length - 1 && <div class="step-connector"></div>}
          </div>

          <!-- Content -->
          <div class="step-card card-glass">
            <div class="step-icon" set:html={step.icon} />
            <h3 class="step-title">{t(lang, step.titleKey)}</h3>
            <p class="step-desc">{t(lang, step.descKey)}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 2.5rem;
    position: relative;
  }

  /* ─── Step ─── */
  .how-step {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-right: 1.5rem;
    position: relative;
  }

  .how-step:last-child { padding-right: 0; }

  /* ─── Track (bubble + line) ─── */
  .step-track {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .step-bubble {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-dim));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 20px var(--glow);
    z-index: 1;
  }

  .step-num {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.75rem;
    color: #000;
    letter-spacing: 0.05em;
  }

  .step-connector {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-accent), var(--border));
    margin-left: -1px;
  }

  /* ─── Step Card ─── */
  .step-card {
    padding: 1.25rem;
    flex: 1;
    margin-right: 1.5rem;
  }

  .how-step:last-child .step-card { margin-right: 0; }

  .step-icon {
    color: var(--accent);
    margin-bottom: 0.75rem;
    opacity: 0.85;
  }

  .step-title {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }

  .step-desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
  }

  /* ─── Mobile: vertical ─── */
  @media (max-width: 768px) {
    .how-timeline {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .how-step {
      flex-direction: row;
      padding-right: 0;
      align-items: flex-start;
      gap: 1rem;
    }

    .step-track {
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
    }

    .step-connector {
      width: 1px;
      height: 100%;
      min-height: 40px;
      background: linear-gradient(180deg, var(--border-accent), var(--border));
      margin-left: 0;
      margin-top: -1px;
    }

    .step-card { margin-right: 0; }
  }
</style>
